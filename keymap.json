// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-i": ["task::Spawn", { "task_name": "worktree install" }],
      "ctrl-alt-d": ["task::Spawn", { "task_name": "dev all (middleware + server + audio_ai + storybook)" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-right": "editor::GoToDefinition",
      "cmd-left": "pane::GoBack"
    }
  },
  {
    "bindings": {
      "ctrl-1": "project_panel::ToggleFocus",
      "ctrl-2": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-t": "workspace::NewTerminal",
    },
  },
]
